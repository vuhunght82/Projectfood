{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoa Sen POS",
  "version": "1.0.0",
  "identifier": "com.hoasen.pos",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://hoangphucglass.cloud",
    "beforeBuildCommand": "",
    "frontendDist": "https://hoangphucglass.cloud"
  },
  "app": {
    "windows": [
      {
        "title": "Nhà Hàng Chay Hoa Sen - POS & Vận Hành",
        "url": "https://hoangphucglass.cloud",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
  "security": {
    "csp": null,
    "capabilities": [
      {
        "identifier": "remote-url-allow",
        "windows": ["main"],
        "remote": {
          "urls": ["https://hoangphucglass.cloud*"]
        },
        "permissions": []
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [  ]
  }
}
